# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Supergroup Forum Username or Chat ID (e.g. @doogagtracker or -100xxxxxxxxxx)
GROUP_CHAT_ID=@doogagauto

# Topic IDs (Optional: if omitted, bot can use general or create topics)
SETTINGS_TOPIC_ID=
HOT_DEALS_TOPIC_ID=

# Database Path
DATABASE_PATH=data/car_arbitrage.db

# Currency Rates
EUR_TO_PLN_RATE=4.30
CZK_TO_EUR_RATE=0.040

# Arbitrage Calculation Parameters
HOT_DEAL_THRESHOLD_PERCENT=15.0
ESTIMATED_TRANSPORT_EUR=400.0
# Web Admin & Public Redirect URL (Set your real domain or ngrok for production, NOT localhost)
WEB_BASE_URL=http://localhost:8000

# Optional Residential Proxy (Required to bypass Akamai/DataDome on Mobile.de and Leboncoin.fr)
# PROXY_URL=http://username:password@proxy-server.com:8080
